# Backend API the console proxies to (server-side only).
BACKEND_API_URL=http://localhost:8000

# Internal control-plane token for the job-board admin API.
# MUST match the backend's ADMIN_API_TOKEN.
#
# Deliberately NOT prefixed NEXT_PUBLIC_: it is read only inside the route
# handler at app/api/job-board/[...path]/route.ts, which runs on the server, so
# the token never reaches the browser bundle. Prefixing it would publish it.
ADMIN_API_TOKEN=ef0rAAfaqcJUCg7kRp5695FX6gC_RCYx2_qtwMxLoFU

# Browser-visible base URL for non-admin API calls.
NEXT_PUBLIC_API_URL=http://localhost:8000
